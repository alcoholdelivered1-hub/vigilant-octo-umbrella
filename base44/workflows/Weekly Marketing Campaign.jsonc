{
  "name": "Weekly Marketing Campaign",
  "description": "Sends a promotional marketing email to all registered users and early signups every Friday at 10am CT \u2014 promotes customer ordering, driver recruitment, and the referral program.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 15 * * 5",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_marketing_campaign",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendMarketingCampaign",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}