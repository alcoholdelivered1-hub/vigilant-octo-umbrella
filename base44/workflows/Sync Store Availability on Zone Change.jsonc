{
  "name": "Sync Store Availability on Zone Change",
  "description": "When a DeliveryZone is updated or deleted, set is_active on all stores in that county based on whether the zone is still active and wet.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "update",
        "delete"
      ],
      "entity_name": "DeliveryZone"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_store_availability_on_zone_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncStoreAvailabilityOnZoneChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}