{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_abc_permit_crosscheck",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "crosscheck": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crossCheckAbcPermitClosures"
          },
          "then": "end",
          "x-base44": {
            "title": "Cross-check ABC permit closures",
            "description": "Check latest ABC report against active stores"
          }
        }
      }
    ]
  },
  "name": "Monthly ABC Permit Closure Cross-Check",
  "description": "Fetches the latest Arkansas ABC Permit Change List, extracts permits marked Inactive (closures/revocations), cross-checks them against all active stores, and emails an alert if any store matches a closed permit.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 15 * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}