{
  "name": "Send Order Confirmation Email on Payment",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"stripe_payment_status\") != null) and (.trigger.data.stripe_payment_status == \"paid\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_order_confirmation_email_on_payment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendOrderConfirmationGmail",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}