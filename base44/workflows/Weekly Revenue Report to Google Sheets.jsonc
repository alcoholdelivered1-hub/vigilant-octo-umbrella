{
  "name": "Weekly Revenue Report to Google Sheets",
  "description": "Every Monday at 6 AM CT, aggregates the prior 7 days of delivered orders (revenue, order counts, fees, tips per store + grand total) and appends a summary to the 'Weekly Summary' tab of the SipSwift Orders Google Sheet.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * 1",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_revenue_report_sheets",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "export_report": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "exportWeeklyReportToSheets",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Export weekly revenue report",
            "description": "Appends per-store + total summary to Google Sheets"
          }
        }
      }
    ]
  }
}