{
  "name": "Alert on Failed ID Verification",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.is_verified == false) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "IDVerification"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alert_on_failed_id_verification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyFailedIDVerification",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}