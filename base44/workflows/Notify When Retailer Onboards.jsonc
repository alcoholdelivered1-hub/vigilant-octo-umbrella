{
  "name": "Notify When Retailer Onboards",
  "description": "Emails the admin when a store completes onboarding and goes live",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"onboarding_status\") != null) and (.trigger.data.onboarding_status == \"live\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Store"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_when_retailer_onboards",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyRetailerOnboarded",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}