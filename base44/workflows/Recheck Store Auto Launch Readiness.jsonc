{
  "name": "Recheck Store Auto Launch Readiness",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recheck_store_auto_launch_readiness",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "check_and_launch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "retailerGoLive",
            "args": {
              "action": "auto_launch"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Check and launch stores",
            "description": "Skip stores already live"
          }
        }
      }
    ]
  },
  "description": "Every five minutes, recheck all retailers awaiting initial launch for remaining payment, driver, permit, inventory and delivery-zone requirements. Activate only fully verified stores; skip previously live stores."
}