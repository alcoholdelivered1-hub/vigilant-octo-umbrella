{
  "name": "Justin Trip Simulation",
  "description": "Advances Justin Bess's GPS position along his route to BEVERAGE KING every 5 minutes. Auto-stops when he arrives.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-07-17T21:32:06.549000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "justin_trip_simulation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "simulateDriverMovement",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}