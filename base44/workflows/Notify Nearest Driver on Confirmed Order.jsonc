{
  "name": "Notify Nearest Driver on Confirmed Order",
  "description": "When an order status changes to confirmed (and has no driver), notify the 3 closest available drivers by email with a one-click claim link.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"confirmed\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_nearest_driver_on_confirmed_order",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNearestDriver",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}