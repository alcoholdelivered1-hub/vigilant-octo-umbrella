{
  "name": "Notify Driver on Assignment",
  "description": "When a driver is assigned to an order, send them an email notification with pickup details.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"driver_id\") != null) and (.trigger.data.driver_id != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_driver_on_assignment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyDriverAssignment",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}