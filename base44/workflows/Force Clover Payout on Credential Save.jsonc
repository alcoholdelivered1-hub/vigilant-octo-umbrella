{
  "name": "Force Clover Payout on Credential Save",
  "description": "When a retailer saves their Clover POS credentials (is_configured=true), automatically syncs Clover inventory, syncs Clover sales to Stripe, and forces a store payout via Stripe Connect.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "StorePosCredential",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.is_configured == true and .trigger.data.pos_system == \"clover\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "force_clover_payout_on_credential_save",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_inventory": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncCloverInventory",
            "args": {
              "store_id": "${ .trigger.data.store_id }"
            }
          },
          "then": "sync_sales",
          "x-base44": {
            "title": "Sync Clover Inventory",
            "description": "Pull products and stock from Clover POS"
          }
        }
      },
      {
        "sync_sales": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncCloverSalesToStripe",
            "args": {
              "action": "sync",
              "store_id": "${ .trigger.data.store_id }"
            }
          },
          "then": "force_payout",
          "x-base44": {
            "title": "Sync Clover Sales to Stripe",
            "description": "Mirror Clover POS sales as Stripe invoices"
          }
        }
      },
      {
        "force_payout": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "weeklyStorePayouts",
            "args": {
              "store_id": "${ .trigger.data.store_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Force Store Payout",
            "description": "Transfer revenue to retailer's Stripe Connect account"
          }
        }
      }
    ]
  }
}