{
  "name": "Push Retailer Documents To Final Approval",
  "description": "Send the designated administrator a native push when retailer evidence is uploaded for review. Deduplicate per document.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "StoreSetupDocument",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"pending_review\" and (.trigger.event_type == \"create\" or .trigger.old_data.status != \"pending_review\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_retailer_documents_to_final_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_admin": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyRetailerStepCompletion",
            "args": {
              "source_entity": "StoreSetupDocument",
              "record_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Push new evidence to administrator",
            "description": "Original evidence still requires review"
          }
        }
      }
    ]
  }
}