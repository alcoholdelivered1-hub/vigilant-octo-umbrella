{
  "name": "Notify Driver When Order Ready for Pickup",
  "description": "Sends the assigned driver an FCM push + email the moment an order becomes pickup_ready at the store, so they know to head out for pickup.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Order",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"pickup_ready\" and .trigger.old_data.status != \"pickup_ready\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_driver_pickup_ready",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_driver": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyDriverPickupReady",
            "args": {
              "order_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify driver order is ready",
            "description": "Push + email the assigned driver"
          }
        }
      }
    ]
  }
}