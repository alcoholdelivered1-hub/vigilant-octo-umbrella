{
  "name": "Validate Clover Credential on Update",
  "description": "When a StorePosCredential record is updated and belongs to Clover, runs a read-only verification check to confirm the token authenticates against the merchant before any sync or payout flow relies on it.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "StorePosCredential",
      "events": [
        "update"
      ]
    },
    "condition": "${ .trigger.data.pos_system == \"clover\" and .trigger.data.is_configured == true }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "validate_clover_credential_on_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "verify_connection": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "verifyCloverOrderConnection",
            "args": {
              "store_id": "${ .trigger.data.store_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Verify Clover Connection",
            "description": "Read-only check that the saved token authenticates against the merchant"
          }
        }
      }
    ]
  }
}