{
  "name": "Log Refused Delivery Compliance Incident",
  "description": "Logs a compliance incident when an order is refused (ID failure, intoxication, minor) and sends immediate admin notification",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"refused\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "log_refused_delivery_compliance_incident",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "logComplianceIncident",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}