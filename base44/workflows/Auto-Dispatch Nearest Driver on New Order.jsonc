{
  "name": "Auto-Dispatch Nearest Driver on New Order",
  "description": "When a new Order is created with status 'pending', automatically assign the nearest available driver based on GPS distance and vehicle capacity.",
  "trigger": {
    "condition": "${ (.trigger.data.status == \"pending\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_dispatch_nearest_driver_on_new_order",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoDispatchOrder",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}