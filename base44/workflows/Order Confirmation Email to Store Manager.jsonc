{
  "name": "Order Confirmation Email to Store Manager",
  "description": "Sends a Gmail notification to the store manager whenever a new order is placed",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "order_confirmation_email_to_store_manager",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendOrderConfirmationEmail",
            "args": {
              "data": "${ .trigger.data }"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}