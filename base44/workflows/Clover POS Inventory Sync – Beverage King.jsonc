{
  "name": "Clover POS Inventory Sync \u2013 Beverage King",
  "description": "Automatically syncs Beverage King's inventory from Clover POS every 10 minutes \u2014 updates prices, availability, and stock quantities.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 10,
      "interval_unit": "minutes",
      "interval_anchor": "2026-07-20T15:07:27.424000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
