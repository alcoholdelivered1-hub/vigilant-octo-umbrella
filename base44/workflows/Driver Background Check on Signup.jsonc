{
  "name": "Driver Background Check on Signup",
  "description": "Automatically triggers a Checkr background check whenever a new Driver record is created. Updates background_check_status on the driver and emails the admin if the check fails.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Driver"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "driver_background_check_on_signup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runDriverBackgroundCheck",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}