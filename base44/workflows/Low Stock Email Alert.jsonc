{
  "name": "Low Stock Email Alert",
  "description": "When a Product's stock_quantity drops to or below 4 on update, email the store manager a per-item low-stock alert.",
  "trigger": {
    "condition": "${ ((.trigger.data.stock_quantity <= 4) and (.trigger.changed_fields | index(\"stock_quantity\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Product"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "low_stock_email_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyLowStockProduct",
            "args": {
              "data": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email store manager \u2014 low stock item",
            "description": "Per-item alert via Gmail"
          }
        }
      }
    ]
  }
}