{
  "name": "Auto Launch Stores After Final Approval",
  "description": "Check a retailer immediately after final launch approval. Activate only after current approval, compliance, inventory, tax, driver, delivery zone, payment and notification checks pass. Previously live stores are skipped.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "RetailerSetupSubmission",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.step == \"launch\" and .trigger.data.status == \"approved\" and .trigger.data.store_id != null and .trigger.data.store_id != \"\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_launch_stores_after_final_approval",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_and_launch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "retailerGoLive",
            "args": {
              "action": "auto_launch",
              "store_id": "${ .trigger.data.store_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Launch approved retailer",
            "description": "Every launch check must pass"
          }
        }
      }
    ]
  }
}