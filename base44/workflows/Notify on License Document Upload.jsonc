{
  "name": "Notify on License Document Upload",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"license_number\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Store"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_on_license_document_upload",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyLicenseUpload",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}