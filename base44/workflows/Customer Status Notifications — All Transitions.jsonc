{
  "name": "Customer Status Notifications \u2014 All Transitions",
  "description": "Emails the customer whenever their order status changes to confirmed, preparing, pickup_ready, cancelled, or refused.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"confirmed\" or .trigger.data.status == \"preparing\" or .trigger.data.status == \"pickup_ready\" or .trigger.data.status == \"cancelled\" or .trigger.data.status == \"refused\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "customer_status_notifications_all_transitions",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyOrderStatusChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}