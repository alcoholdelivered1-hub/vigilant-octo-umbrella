{
  "name": "Notify Message Recipient",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Message"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_message_recipient",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyMessageRecipient",
            "args": {
              "data": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify message recipient",
            "description": "Email + push the non-sender party"
          }
        }
      }
    ]
  },
  "description": "Emails and pushes the non-sender party (driver/store/customer) when a new chat message is created on an order."
}