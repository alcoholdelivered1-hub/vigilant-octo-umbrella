{
  "name": "Auto-Sync Drive Onboarding Spreadsheets",
  "description": "Watches your Google Drive for changes and automatically imports any spreadsheet with \"onboarding\" in the filename into the Store database, keeping contact emails and onboarding status in sync.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "connector",
      "events": [
        "changes"
      ],
      "integration_type": "googledrive",
      "resource_id": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_sync_drive_onboarding_spreadsheets",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncDriveOnboardingSheets",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}