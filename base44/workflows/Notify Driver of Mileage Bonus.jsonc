{
  "name": "Notify Driver of Mileage Bonus",
  "description": "Fires when a driver is assigned to an order with distance over 7 miles, notifying them of their extra mileage pay.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"driver_id\") != null) and (.trigger.data.driver_id != null and .trigger.data.driver_id != \"\" and .trigger.data.driver_id != [] and .trigger.data.driver_id != {}) and (.trigger.data.distance_miles > 7)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_driver_of_mileage_bonus",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyDriverMileageBonus",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}