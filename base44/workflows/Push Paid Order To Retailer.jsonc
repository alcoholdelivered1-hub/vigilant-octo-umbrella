{
  "name": "Push Paid Order To Retailer",
  "description": "Priority #1 \u2014 When a customer's order payment becomes paid, immediately push the order to the retailer via email and mobile push so they can confirm and begin preparation.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Order",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.stripe_payment_status == \"paid\" and (.trigger.event_type == \"create\" or .trigger.old_data.stripe_payment_status != \"paid\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_paid_order_to_retailer",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_retailer": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyRetailerNewOrder",
            "args": {
              "event": {
                "type": "create"
              },
              "data": "${ .trigger.data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Push paid order to retailer",
            "description": "Email and push notification the moment payment is confirmed"
          }
        }
      }
    ]
  }
}