{
  "name": "Alert on Driver Sign-In",
  "description": "Sends an email + push alert to the admin when a driver's status changes to \"available\" (signing in for deliveries).",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"available\") and (.trigger.old_data.status != \"available\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Driver"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alert_on_driver_sign_in",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyDriverSignIn",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}