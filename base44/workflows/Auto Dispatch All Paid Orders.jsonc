{
  "name": "Auto Dispatch All Paid Orders",
  "description": "When any paid order is retailer-confirmed, automatically assign the nearest available cleared driver or DoorDash. Extends auto-dispatch beyond priority stores to every retailer.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Order",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.stripe_payment_status == \"paid\" and (.trigger.data.status == \"confirmed\" or .trigger.data.status == \"preparing\" or .trigger.data.status == \"pickup_ready\") and (.trigger.data.driver_id // \"\") == \"\" and (.trigger.event_type == \"create\" or .trigger.old_data.status != .trigger.data.status or .trigger.old_data.stripe_payment_status != \"paid\" or (.trigger.old_data.driver_id // \"\") != \"\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_dispatch_all_paid_orders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "assign_driver": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoDispatchOrder",
            "args": {
              "order_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Assign driver to paid order",
            "description": "Nearest cleared driver or DoorDash for any retailer"
          }
        }
      }
    ]
  }
}