{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Refresh the shared store onboarding tracker every five minutes, including related agreement, catalog, tax and sandbox-test evidence. One-way app-to-sheet sync; never activates stores.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "refresh_store_onboarding_google_sheet",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_tracker": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncStoreOnboardingToSheets",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Update onboarding tracker",
            "description": "All stores, latest saved setup status"
          }
        }
      }
    ]
  },
  "name": "Refresh Store Onboarding Google Sheet"
}