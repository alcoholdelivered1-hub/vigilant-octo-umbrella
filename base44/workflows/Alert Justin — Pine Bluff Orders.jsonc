{
  "name": "Alert Justin \u2014 Pine Bluff Orders",
  "description": "Emails Justin Bess instantly when a new order comes in from a Pine Bluff / Jefferson County store",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alert_justin_pine_bluff_orders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyJustinPineBluffOrders",
            "args": {
              "data": "${ .trigger.data }"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}