{
  "name": "Auto-Sync Inventory from Google Sheet",
  "description": "Automatically syncs product prices and stock from the connected Google Sheet every 15 minutes, so customer-facing prices always match retailer updates.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": "2026-07-17T14:17:39.665000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_sync_inventory_from_google_sheet",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoSyncInventoryFromSheet",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}