{
  "name": "Store",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Licensed retailer name"
    },
    "license_number": {
      "type": "string",
      "description": "Arkansas ABC license number"
    },
    "license_status": {
      "type": "string",
      "enum": [
        "unknown",
        "pending",
        "active",
        "expired",
        "suspended"
      ],
      "description": "Verified retail license status; independent of payment and onboarding status"
    },
    "license_expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Verified Arkansas ABC retail license expiration date"
    },
    "address": {
      "type": "string",
      "description": "Store street address"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "county": {
      "type": "string",
      "description": "County name"
    },
    "state": {
      "type": "string",
      "default": "AR"
    },
    "zip_code": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Store contact email for order notifications"
    },
    "contact_emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "description": "Additional retailer contacts authorized to access the onboarding tracker"
    },
    "notification_phone": {
      "type": "string",
      "description": "SMS-capable phone number for order alerts (optional)"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "operating_hours_start": {
      "type": "string",
      "description": "Default weekday opening time e.g. 07:00"
    },
    "operating_hours_end": {
      "type": "string",
      "description": "Default weekday closing time e.g. 01:00"
    },
    "saturday_hours_start": {
      "type": "string",
      "description": "Saturday opening time e.g. 07:00"
    },
    "saturday_hours_end": {
      "type": "string",
      "description": "Saturday closing time e.g. 00:00"
    },
    "sunday_closed": {
      "type": "boolean",
      "default": true,
      "description": "If true, store is closed on Sundays"
    },
    "sunday_hours_start": {
      "type": "string",
      "description": "Sunday opening time (if not closed)"
    },
    "sunday_hours_end": {
      "type": "string",
      "description": "Sunday closing time (if not closed)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_browsable": {
      "type": "boolean",
      "default": false,
      "description": "Visible in browse mode before go-live; ordering remains disabled."
    },
    "image_url": {
      "type": "string"
    },
    "placement_tier": {
      "type": "string",
      "enum": [
        "standard",
        "featured",
        "premium"
      ],
      "default": "standard",
      "description": "Optional paid placement: standard free, featured $50/mo, premium $150/mo"
    },
    "placement_expires": {
      "type": "string",
      "format": "date"
    },
    "compliance_status": {
      "type": "string",
      "enum": [
        "compliant",
        "flagged",
        "expired",
        "suspended"
      ],
      "default": "compliant"
    },
    "compliance_notes": {
      "type": "string"
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "pending",
        "invited",
        "contract_sent",
        "contract_signed",
        "inventory_added",
        "live"
      ],
      "default": "invited"
    },
    "compliance_template": {
      "type": "string",
      "enum": [
        "retailer_agreement"
      ]
    },
    "onboarding_notes": {
      "type": "string"
    },
    "contract_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "reminder_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "stripe_connect_account_id": {
      "type": "string"
    },
    "stripe_connection_status": {
      "type": "string",
      "enum": [
        "disconnected",
        "pending",
        "connected"
      ],
      "default": "disconnected"
    },
    "stripe_connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "preferred_payment_provider": {
      "type": "string",
      "enum": [
        "stripe",
        "clover"
      ],
      "default": "stripe",
      "description": "Retailer payment preference; not proof that a payment processor is enabled."
    },
    "clover_ecommerce_approved": {
      "type": "boolean",
      "default": false,
      "description": "Administrator-verified Clover card-not-present Ecommerce approval for alcohol transactions."
    },
    "clover_commission_agreement_approved": {
      "type": "boolean",
      "default": false,
      "description": "Administrator-verified agreement covering 25% merchandise commission and settlement of delivery fees and tips."
    },
    "clover_webhook_test_passed": {
      "type": "boolean",
      "default": false,
      "description": "Administrator-verified signed Clover webhook, payment matching and order notification test."
    },
    "clover_checkout_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Admin opt-in gate; never by itself proves Clover checkout readiness or permits customer charging."
    },
    "liquorbee_merchant_id": {
      "type": "string",
      "description": "Merchant ID LiquorBee assigns to this store; required for LiquorBee Partner API calls on its behalf."
    },
    "sales_tax_rate": {
      "type": "number",
      "description": "Configurable checkout sales-tax rate pending verified destination/category tax engine."
    },
    "is_test_store": {
      "type": "boolean",
      "default": false,
      "description": "End-to-end test retailer. Checkout runs in Stripe test mode on the platform account: no real money, no retailer Connect account, and paid orders are marked as test orders."
    }
  },
  "required": [
    "name",
    "license_number",
    "address",
    "city",
    "county"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}