{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "category": {
      "type": "string",
      "enum": [
        "beer",
        "wine",
        "spirits",
        "mixers",
        "accessories"
      ],
      "description": "Product category"
    },
    "brand": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "description": "Price in USD"
    },
    "volume": {
      "type": "string",
      "description": "e.g. 750ml, 12oz, etc."
    },
    "abv": {
      "type": "number",
      "description": "Alcohol by volume percentage"
    },
    "store_id": {
      "type": "string",
      "description": "Reference to the Store"
    },
    "image_url": {
      "type": "string"
    },
    "in_stock": {
      "type": "boolean",
      "default": true
    },
    "stock_quantity": {
      "type": "number",
      "description": "Current inventory count. Leave blank if not tracking quantity."
    },
    "external_id": {
      "type": "string",
      "description": "Retailer POS item identifier"
    },
    "sku": {
      "type": "string",
      "description": "Retailer SKU"
    },
    "upc": {
      "type": "string",
      "description": "Retailer barcode or UPC"
    },
    "inventory_source": {
      "type": "string",
      "enum": [
        "clover",
        "cityhive",
        "liquor_bee",
        "manual",
        "csv"
      ],
      "description": "Authoritative source for price and availability"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "Most recent successful source synchronization"
    }
  },
  "required": [
    "name",
    "category",
    "price",
    "store_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}