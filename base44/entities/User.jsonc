{
  "type": "object",
  "name": "User",
  "title": "User",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "customer",
        "driver",
        "retailer_staff",
        "retailer_owner"
      ],
      "default": "user",
      "description": "User role: admin, user/customer, driver, retailer_staff, retailer_owner",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "referral_code": {
      "type": "string"
    },
    "referred_by_code": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "referred_by_email": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "referral_count": {
      "type": "number",
      "default": 0,
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "referral_credits": {
      "type": "number",
      "default": 0,
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "loyalty_points": {
      "type": "number",
      "default": 0,
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "loyalty_total_spent": {
      "type": "number",
      "default": 0,
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "onboarding_data": {
      "type": "object"
    },
    "background_check_submitted": {
      "type": "boolean",
      "default": false
    },
    "background_check_date": {
      "type": "string"
    },
    "livescan_completed": {
      "type": "boolean",
      "default": false
    },
    "livescan_location": {
      "type": "string"
    },
    "livescan_date": {
      "type": "string"
    },
    "verification_code": {
      "type": "string"
    },
    "verification_code_expires": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_connect_account_id": {
      "type": "string",
      "description": "Stripe Connect Express account ID for driver payouts",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "stripe_connect_onboarded": {
      "type": "boolean",
      "default": false,
      "description": "True when the driver has completed Stripe Connect onboarding"
    }
  },
  "required": [
    "verification_code",
    "livescan_location",
    "verification_code_expires",
    "referral_code",
    "referred_by_email",
    "background_check_date",
    "livescan_date",
    "stripe_connect_account_id",
    "onboarding_data",
    "referred_by_code"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}