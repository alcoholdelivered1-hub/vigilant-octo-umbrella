{
  "name": "CloverInventoryStaging",
  "type": "object",
  "properties": {
    "clover_item_id": {
      "type": "string",
      "description": "Clover item ID \u2014 dedup key with store_id"
    },
    "store_id": {
      "type": "string",
      "description": "Store this staged item belongs to (hard-scoped, never cross-store)"
    },
    "store_name": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Real item name pulled from Clover"
    },
    "sku": {
      "type": "string",
      "description": "SKU/UPC resolved from Clover code or sku field"
    },
    "code": {
      "type": "string",
      "description": "Raw Clover item code"
    },
    "brand": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "beer",
        "wine",
        "spirits",
        "mixers",
        "accessories"
      ],
      "description": "Inferred product category"
    },
    "clover_categories": {
      "type": "string",
      "description": "Comma-separated Clover category names as received"
    },
    "price": {
      "type": "number",
      "description": "Unit price in USD (Clover price / 100)"
    },
    "price_type": {
      "type": "string",
      "description": "Clover priceType e.g. PER_UNIT, FIXED"
    },
    "unit_name": {
      "type": "string",
      "description": "Clover unitName e.g. EACH, OZ"
    },
    "pack_size": {
      "type": "string",
      "default": "Single"
    },
    "volume": {
      "type": "string"
    },
    "stock_quantity": {
      "type": "number",
      "description": "Clover item stock count (null if unavailable)"
    },
    "in_stock": {
      "type": "boolean",
      "default": true
    },
    "hidden": {
      "type": "boolean",
      "description": "Clover hidden flag (true = not available for sale)"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this staged record was imported from Clover"
    },
    "spot_check_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Admin review status during spot-check before promotion to live catalog"
    },
    "notes": {
      "type": "string",
      "description": "Admin notes during spot-check review"
    }
  },
  "required": [
    "clover_item_id",
    "store_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}