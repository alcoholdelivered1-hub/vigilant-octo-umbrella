{
  "name": "DeliveryEligibilityLog",
  "type": "object",
  "properties": {
    "order_or_session_id": {
      "type": "string",
      "description": "Order number or checkout session identifier"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email if authenticated"
    },
    "customer_latitude": {
      "type": "number",
      "description": "Geocoded delivery latitude (admin-only, never displayed publicly)"
    },
    "customer_longitude": {
      "type": "number",
      "description": "Geocoded delivery longitude (admin-only, never displayed publicly)"
    },
    "matched_municipality": {
      "type": "string",
      "description": "Municipality resolved from geocoded coordinates"
    },
    "matched_county": {
      "type": "string",
      "description": "County resolved from geocoded coordinates"
    },
    "service_zone_result": {
      "type": "string",
      "description": "Whether the address fell inside an approved service zone (pass/fail) plus zone name"
    },
    "wet_jurisdiction_result": {
      "type": "string",
      "description": "Wet/dry jurisdiction verification result (pass/fail/unverified)"
    },
    "retailer_eligibility_result": {
      "type": "string",
      "description": "Whether the retailer was licensed, approved, and permitted to deliver (pass/fail)"
    },
    "boundary_dataset_version": {
      "type": "string",
      "description": "Arkansas GIS boundary dataset version used for this check"
    },
    "verification_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the eligibility check was performed"
    },
    "final_result": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ],
      "description": "Whether checkout was allowed or blocked"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Human-readable reason if the check was rejected"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this eligibility log entry"
    }
  },
  "required": [
    "order_or_session_id",
    "final_result"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}