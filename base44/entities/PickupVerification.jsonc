{
  "name": "PickupVerification",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Reference to the Order"
    },
    "order_number": {
      "type": "string"
    },
    "driver_id": {
      "type": "string",
      "description": "User ID of the driver who confirmed pickup"
    },
    "driver_name": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "store_name": {
      "type": "string",
      "description": "Retailer name at time of pickup"
    },
    "pickup_latitude": {
      "type": "number",
      "description": "GPS latitude where pickup was confirmed"
    },
    "pickup_longitude": {
      "type": "number",
      "description": "GPS longitude where pickup was confirmed"
    },
    "pickup_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time pickup was confirmed"
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of completed checklist item labels"
    },
    "sealed_bag_photo_url": {
      "type": "string",
      "description": "Photo of the sealed order bag"
    },
    "reported_problems": {
      "type": "string",
      "description": "Any missing, incorrect, or substituted items reported by the driver"
    },
    "has_problems": {
      "type": "boolean",
      "default": false,
      "description": "True if the driver reported any problems or substitutions"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this pickup verification"
    }
  },
  "required": [
    "order_id",
    "order_number",
    "driver_id",
    "driver_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}