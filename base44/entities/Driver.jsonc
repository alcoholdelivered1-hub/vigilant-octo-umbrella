{
  "name": "Driver",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "license_number": {
      "type": "string",
      "description": "Driver license number"
    },
    "training_completed": {
      "type": "boolean",
      "default": false,
      "description": "Alcohol delivery law training completed"
    },
    "training_completed_date": {
      "type": "string",
      "format": "date"
    },
    "training_certificate_file_uri": {
      "type": "string",
      "description": "Private uploaded training certificate, linked to the driver record for audit"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "on_delivery",
        "offline",
        "suspended"
      ],
      "default": "offline"
    },
    "current_latitude": {
      "type": "number"
    },
    "current_longitude": {
      "type": "number"
    },
    "total_deliveries": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "vehicle_info": {
      "type": "string"
    },
    "avg_rating": {
      "type": "number",
      "description": "Average customer star rating (1-5), auto-updated on each new rating"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or bio for this driver"
    },
    "background_check_status": {
      "type": "string",
      "enum": [
        "pending",
        "clear",
        "manual_clear",
        "failed",
        "error"
      ],
      "default": "pending",
      "description": "Status of the third-party background check. manual_clear = admin-uploaded PDF approved offline."
    },
    "background_check_id": {
      "type": "string",
      "description": "External background check report ID (Checkr)"
    },
    "background_check_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the background check was completed"
    },
    "background_check_submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Consent-form submission timestamp, not provider clearance"
    },
    "background_check_file_uri": {
      "type": "string",
      "description": "Private uploaded background check PDF for manual admin review"
    },
    "background_check_manual_reviewer": {
      "type": "string",
      "description": "Admin email who manually approved the uploaded background check PDF"
    },
    "background_check_manual_approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when admin approved the manual background check upload"
    },
    "service_city": {
      "type": "string",
      "description": "Driver-selected city for retailer coverage planning"
    },
    "license_file_uri": {
      "type": "string",
      "description": "Private uploaded driver license"
    },
    "insurance_file_uri": {
      "type": "string",
      "description": "Private uploaded insurance document, linked to the driver record for audit"
    }
  },
  "required": [
    "name",
    "email",
    "phone"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}