{
  "name": "DriverStoreCoverage",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_email": {
      "type": "string"
    }
  },
  "required": [
    "store_id",
    "store_name",
    "city",
    "driver_id",
    "driver_name",
    "driver_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.driver_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}