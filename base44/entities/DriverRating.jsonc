{
  "name": "DriverRating",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "Reference to the Driver"
    },
    "driver_name": {
      "type": "string"
    },
    "order_id": {
      "type": "string",
      "description": "Reference to the Order"
    },
    "order_number": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating 1-5"
    },
    "comment": {
      "type": "string",
      "description": "Optional review text"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this driver rating"
    }
  },
  "required": [
    "driver_id",
    "order_id",
    "customer_email",
    "rating"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}