{
  "name": "StorePosCredential",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Reference to the Store"
    },
    "store_name": {
      "type": "string",
      "description": "Store name for display"
    },
    "store_email": {
      "type": "string",
      "description": "Store contact email used for RLS matching"
    },
    "pos_system": {
      "type": "string",
      "enum": [
        "clover",
        "square",
        "toast",
        "ncr",
        "lightspeed",
        "shopkeep",
        "other",
        "none"
      ],
      "default": "clover",
      "description": "Which POS system these credentials are for"
    },
    "merchant_id": {
      "type": "string",
      "description": "POS merchant ID, location ID, or restaurant GUID"
    },
    "api_token": {
      "type": "string",
      "description": "POS API token or access token"
    },
    "api_secret": {
      "type": "string",
      "description": "Optional API secret or client secret (some POS systems require this)"
    },
    "refresh_token": {
      "type": "string",
      "description": "Clover OAuth refresh token, managed by backend functions and not displayed in client forms"
    },
    "app_id": {
      "type": "string",
      "description": "Optional POS app/client ID (some systems like Clover require this)"
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "sandbox"
      ],
      "default": "production",
      "description": "Whether these credentials are for the POS production or sandbox environment"
    },
    "is_configured": {
      "type": "boolean",
      "default": false,
      "description": "True once the retailer has entered at least a merchant ID and API token"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about this POS configuration"
    }
  },
  "required": [
    "store_id",
    "store_email",
    "pos_system"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.store_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.store_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.store_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}