{
  "name": "InventorySyncConfig",
  "type": "object",
  "properties": {
    "spreadsheet_url": {
      "type": "string",
      "description": "Google Sheet URL or ID that retailers edit to update prices"
    },
    "sheet_name": {
      "type": "string",
      "description": "Optional sheet tab name (leave blank for first tab)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether automatic sync is enabled"
    },
    "sync_interval_minutes": {
      "type": "number",
      "default": 15,
      "description": "How often the scheduled automation should run (informational; actual interval is set on the automation)"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last automatic sync ran"
    },
    "last_sync_status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "pending"
      ],
      "default": "pending"
    },
    "last_sync_summary": {
      "type": "string",
      "description": "Human-readable summary of the last sync result"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this sync configuration"
    }
  },
  "required": [
    "spreadsheet_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}