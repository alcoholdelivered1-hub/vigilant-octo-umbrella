{
  "name": "StorePayout",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Store ID this payout belongs to"
    },
    "store_name": {
      "type": "string"
    },
    "store_email": {
      "type": "string"
    },
    "week_start": {
      "type": "string",
      "format": "date",
      "description": "Monday of the pay week"
    },
    "week_end": {
      "type": "string",
      "format": "date",
      "description": "Sunday of the pay week"
    },
    "order_count": {
      "type": "number",
      "default": 0,
      "description": "Number of delivered orders in this period"
    },
    "gross_revenue": {
      "type": "number",
      "description": "Total order subtotals (product revenue) for the period"
    },
    "tax_collected": {
      "type": "number",
      "default": 0,
      "description": "Total sales + excise tax collected on behalf of the store"
    },
    "total_amount": {
      "type": "number",
      "description": "Total amount transferred to the store (gross_revenue + tax_collected)"
    },
    "stripe_connect_account_id": {
      "type": "string",
      "description": "Store's Stripe Connect Express account ID"
    },
    "stripe_transfer_id": {
      "type": "string",
      "description": "Stripe transfer ID if payout was processed"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "skipped",
        "failed"
      ],
      "default": "pending",
      "description": "pending=not yet run, paid=successfully transferred, skipped=no orders or no Connect account, failed=Stripe error"
    },
    "error_message": {
      "type": "string",
      "description": "Error details if status=failed"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this payout"
    }
  },
  "required": [
    "store_id",
    "week_start",
    "total_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.store_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}