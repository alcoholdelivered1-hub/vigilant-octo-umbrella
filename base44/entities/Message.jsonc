{
  "name": "Message",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Reference to the Order"
    },
    "order_number": {
      "type": "string"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "driver",
        "store",
        "customer"
      ],
      "description": "Who sent this message"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_email": {
      "type": "string",
      "description": "Authenticated sender email"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer participant in customer-driver chat"
    },
    "driver_id": {
      "type": "string",
      "description": "Assigned driver record or user ID"
    },
    "driver_email": {
      "type": "string",
      "description": "Assigned driver's email for chat access"
    },
    "store_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Authorized retailer contacts in store-driver chat"
    },
    "channel": {
      "type": "string",
      "enum": [
        "customer_driver",
        "store_driver"
      ]
    },
    "text": {
      "type": "string",
      "description": "Message content",
      "maxLength": 2000
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "order_id",
    "sender_role",
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "data.sender_email": "{{user.email}}"
        },
        {
          "data.driver_email": "{{user.email}}"
        },
        {
          "data.store_emails": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}