{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Unique order identifier"
    },
    "receipt_token": {
      "type": "string",
      "description": "Server-generated unguessable token required for anonymous receipt lookup. Never derived from the timestamp-based order number."
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "store_id": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "price": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "mileage_surcharge": {
      "type": "number",
      "default": 0,
      "description": "Extra $1/mile charge for distances over 7 miles (goes to driver)"
    },
    "distance_miles": {
      "type": "number",
      "description": "Calculated distance in miles from store to delivery address"
    },
    "tax": {
      "type": "number"
    },
    "tip": {
      "type": "number",
      "default": 0,
      "description": "Driver tip amount in USD"
    },
    "total": {
      "type": "number"
    },
    "service_fee": {
      "type": "number"
    },
    "stripe_payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending",
      "description": "Stripe payment status"
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe checkout session ID"
    },
    "stripe_connect_account_id": {
      "type": "string",
      "description": "Licensed retailer's connected Stripe account that owns this direct charge"
    },
    "stripe_application_fee_amount": {
      "type": "number",
      "description": "Platform application fee in USD: service, delivery, mileage and driver tip"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "pickup_ready",
        "in_transit",
        "delivered",
        "cancelled",
        "refused"
      ],
      "default": "pending"
    },
    "delivery_address": {
      "type": "string"
    },
    "delivery_latitude": {
      "type": "number"
    },
    "delivery_longitude": {
      "type": "number"
    },
    "order_latitude": {
      "type": "number",
      "description": "GPS location where order was placed"
    },
    "order_longitude": {
      "type": "number"
    },
    "driver_id": {
      "type": "string"
    },
    "driver_email": {
      "type": "string",
      "description": "Authenticated driver email used for assigned-order access control"
    },
    "driver_name": {
      "type": "string"
    },
    "driver_current_latitude": {
      "type": "number",
      "description": "Live driver GPS latitude, updated during in_transit"
    },
    "driver_current_longitude": {
      "type": "number",
      "description": "Live driver GPS longitude, updated during in_transit"
    },
    "driver_location_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time driver GPS was updated"
    },
    "doordash_delivery_id": {
      "type": "string",
      "description": "DoorDash Drive delivery ID when fulfillment is handled by DoorDash"
    },
    "id_verified_at_checkout": {
      "type": "boolean",
      "default": false
    },
    "id_verified_at_delivery": {
      "type": "boolean",
      "default": false
    },
    "delivery_signature_url": {
      "type": "string"
    },
    "delivery_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "pickup_confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "refusal_reason": {
      "type": "string",
      "description": "Reason if delivery was refused"
    },
    "is_in_legal_zone": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "liquorbee_order_id": {
      "type": "string",
      "description": "LiquorBee order identifier returned when the order was pushed to the retailer's POS"
    },
    "liquorbee_status": {
      "type": "string",
      "enum": [
        "Open",
        "Ready",
        "Closed"
      ],
      "description": "Mirror of the LiquorBee POS status. Never replaces the app's own delivery status."
    },
    "liquorbee_is_stale": {
      "type": "boolean",
      "description": "LiquorBee reports the POS copy of this order as stale"
    },
    "liquorbee_pos_modified": {
      "type": "boolean",
      "description": "LiquorBee reports the order was changed at the POS"
    },
    "liquorbee_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful LiquorBee synchronization"
    },
    "liquorbee_last_error": {
      "type": "string",
      "description": "Last LiquorBee submission or status error; cleared on the next success"
    }
  },
  "required": [
    "customer_email",
    "customer_name",
    "store_id",
    "items",
    "total",
    "delivery_address"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.customer_email": "{{user.email}}"
            },
            {
              "data.customer_email": {
                "$nin": [
                  null,
                  ""
                ]
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.driver_email": "{{user.email}}"
            },
            {
              "data.driver_email": {
                "$nin": [
                  null,
                  ""
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}