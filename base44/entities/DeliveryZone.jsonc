{
  "name": "DeliveryZone",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Zone name e.g. county name"
    },
    "county": {
      "type": "string"
    },
    "is_wet": {
      "type": "boolean",
      "default": true,
      "description": "Whether alcohol sales are legal"
    },
    "center_latitude": {
      "type": "number"
    },
    "center_longitude": {
      "type": "number"
    },
    "radius_miles": {
      "type": "number",
      "description": "Delivery radius in miles"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "legal_hours_start": {
      "type": "string",
      "description": "Legal sale start time e.g. 07:00"
    },
    "legal_hours_end": {
      "type": "string",
      "description": "Legal sale end time e.g. 02:00"
    },
    "delivery_fee": {
      "type": "number",
      "description": "Custom delivery fee for this zone (USD)",
      "default": 3
    },
    "min_order_amount": {
      "type": "number",
      "description": "Minimum order subtotal required for this zone (USD)",
      "default": 20
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this delivery zone"
    }
  },
  "required": [
    "name",
    "county"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}