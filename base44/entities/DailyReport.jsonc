{
  "name": "DailyReport",
  "type": "object",
  "properties": {
    "report_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the report (YYYY-MM-DD)"
    },
    "store_id": {
      "type": "string"
    },
    "store_name": {
      "type": "string"
    },
    "total_revenue": {
      "type": "number",
      "description": "Total revenue for the day"
    },
    "total_orders": {
      "type": "number",
      "description": "Number of completed orders"
    },
    "avg_order_value": {
      "type": "number",
      "description": "Average order value"
    },
    "delivery_fees_collected": {
      "type": "number"
    },
    "items_sold": {
      "type": "number",
      "description": "Total items sold"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or summary for this daily report"
    }
  },
  "required": [
    "report_date",
    "store_id",
    "store_name",
    "total_revenue"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}