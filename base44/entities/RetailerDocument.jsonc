{
  "name": "RetailerDocument",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "Reference to the Store this document belongs to"
    },
    "store_name": {
      "type": "string",
      "description": "Store name for display"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "retailer_agreement",
        "abc_license",
        "clover_authorization",
        "stripe_connect",
        "insurance",
        "store_profile",
        "go_live_checklist"
      ],
      "description": "Type of onboarding document"
    },
    "file_uri": {
      "type": "string",
      "description": "Private file URI from UploadPrivateFile"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "uploaded",
        "verified",
        "rejected"
      ],
      "default": "pending",
      "description": "Review status of the document"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the document was uploaded"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When an admin verified the document"
    },
    "notes": {
      "type": "string",
      "description": "Admin notes about this document"
    }
  },
  "required": [
    "store_id",
    "document_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}